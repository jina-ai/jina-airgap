# Jina AI Model: On-Prem Docker Image, CPU variant
# Phase 1, bundle: bakes model weights and model-specific deps into image.
# Phase 2, deploy: runs fully offline, zero external network calls.
#
# All model dependency versions are pinned in catalog.json and written to
# model-requirements.txt at bundle time. This Dockerfile installs exactly
# those versions, nothing more.

ARG MODEL_ID=jinaai/jina-embeddings-v5-text-nano
ARG MODEL_REVISION=""
ARG HF_TOKEN=""

# ---------------------------------------------------------------------------
# Stage 1: Download model weights and pre-cache dynamic modules
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS downloader

ARG MODEL_ID
ARG MODEL_REVISION
ARG HF_TOKEN
ARG EXTRA_REPOS=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/model_cache \
    HF_TOKEN=${HF_TOKEN} \
    MODEL_ID=${MODEL_ID} \
    MODEL_REVISION=${MODEL_REVISION} \
    EXTRA_REPOS=${EXTRA_REPOS}

# Install model deps from pinned requirements for download and pre-load
# torch and torchvision from CPU index, then remaining deps from PyPI
COPY docker/model-requirements.txt /tmp/model-requirements.txt
RUN TORCH_VER=$(grep -i '^torch==' /tmp/model-requirements.txt | head -1 | sed 's/torch//') && \
    TV_VER=$(grep -i '^torchvision==' /tmp/model-requirements.txt | head -1 | sed 's/torchvision//') && \
    pip install --no-cache-dir "torch${TORCH_VER}" "torchvision${TV_VER}" --index-url https://download.pytorch.org/whl/cpu
RUN grep -v '^\s*#' /tmp/model-requirements.txt | grep -v '^\s*$' | \
    grep -iv '^torch' | grep -iv '^flash-attn' | \
    xargs --no-run-if-empty pip install --no-cache-dir

# Copy and run the download script
COPY docker/download_model.py docker/verify_staging.py /tmp/
RUN python /tmp/download_model.py

# ---------------------------------------------------------------------------
# Stage 2: Runtime image, CPU-only, lean
# python:3.11-slim base, no CUDA toolkit, much smaller image
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install model deps from pinned requirements
# torch and torchvision from CPU index, flash-attn skipped for CPU
#
# Server code is COPYed last, after every multi-GB layer, so editing it
# invalidates only the final layer. With it first, one line of Python forced a
# full torch reinstall and weight re-copy on every image built.
COPY docker/model-requirements.txt /tmp/model-requirements.txt
RUN TORCH_VER=$(grep -i '^torch==' /tmp/model-requirements.txt | head -1 | sed 's/torch//') && \
    TV_VER=$(grep -i '^torchvision==' /tmp/model-requirements.txt | head -1 | sed 's/torchvision//') && \
    pip install --no-cache-dir "torch${TORCH_VER}" "torchvision${TV_VER}" --index-url https://download.pytorch.org/whl/cpu
RUN grep -v '^\s*#' /tmp/model-requirements.txt | grep -v '^\s*$' | \
    grep -iv '^torch' | grep -iv '^flash-attn' | \
    xargs --no-run-if-empty pip install --no-cache-dir

# Server framework deps, pinned
RUN pip install --no-cache-dir \
    "fastapi==0.115.6" \
    "uvicorn[standard]==0.32.1"

# Copy cached model weights from downloader stage
COPY --from=downloader /model_cache /model_cache

# Server code, last: the only layer a code change rebuilds.
COPY models/catalog.json /app/catalog.json
COPY server/ /app/

# Enforce air-gap: all model files are baked in, no downloads at runtime
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    JINA_OFFLINE=1 \
    HF_HOME=/model_cache \
    TRUST_REMOTE_CODE=1 \
    HF_HUB_TRUST_REMOTE_CODE=1

# License gate signing secret. Optional; defaults to the public constant in
# server/license.py. Rotate at bundle time with --build-arg LICENSE_SECRET=...
# (must match `keygen --secret`). Symbolic compliance gate, not DRM.
ARG LICENSE_SECRET=""
ENV JINA_LICENSE_SECRET=${LICENSE_SECRET}

# CPU threading: let runtime auto-detect core count
# Override at runtime: docker run -e OMP_NUM_THREADS=8 ...
#
# CPU bf16 autocast: auto-enabled on CPUs with native bf16 matmul (Intel AMX on
# Sapphire Rapids+, or AVX512_BF16 on Cooper Lake / AMD Zen4). Measured 1.8-2.5x
# encode throughput at batch with cos-sim ~0.9999 vs fp32. Auto-detected from
# /proc/cpuinfo; force with -e JINA_CPU_AUTOCAST=bf16 or disable with =off.

LABEL org.opencontainers.image.source=https://github.com/jina-ai/jina-on-prem
LABEL org.opencontainers.image.description="Jina AI air-gapped embedding/reranker model - CPU variant"
LABEL org.opencontainers.image.licenses=Apache-2.0

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -sf http://localhost:8080/health || exit 1

CMD ["sh", "-c", "JINA_MODEL_ID=$(cat /model_cache/MODEL_ID) exec python app.py"]
